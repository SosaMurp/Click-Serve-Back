# Copia este archivo como .env y llena los valores. No subas .env al repositorio.
PORT=3000
# development habilita sandbox de pagos, códigos en consola y llaves de respaldo.
# Sin NODE_ENV (o con production) todo eso queda apagado y faltar una llave detiene la función.
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=clickyserve_db

# Seguridad (obligatorias en producción)
JWT_SECRET=cambia-esta-llave-larga-y-aleatoria
FILES_SECRET=otra-llave-larga-y-aleatoria

# Correo para códigos de verificación (sin estos valores: en development se imprimen en consola; fuera de development no se envían)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SERVICE=gmail  o  SMTP_HOST / SMTP_PORT / SMTP_SECURE

# SMS para recuperación por SMS (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Pagos con Conekta (sin llave privada: en development los cargos son SANDBOX; fuera de development se rechazan)
CONEKTA_PRIVATE_KEY=

# Servicio biométrico (biometric-service/) y consulta de cédulas SEP
BIOMETRIC_SERVICE_URL=http://127.0.0.1:8000
# SEP_URL=https://www.cedulaprofesional.sep.gob.mx/cedula/buscaCedulaJson.action

# 1 = responde 503 en toda la API (mantenimiento)
MAINTENANCE=0
