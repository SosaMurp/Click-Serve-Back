# Copia este archivo como .env y llena los valores. No subas .env al repositorio.
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=clickyserve_db

# Seguridad (obligatorias en producción)
JWT_SECRET=cambia-esta-llave-larga-y-aleatoria
FILES_SECRET=otra-llave-larga-y-aleatoria

# Correo para códigos de verificación (sin estos valores se imprimen en consola)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SERVICE=gmail  o  SMTP_HOST / SMTP_PORT / SMTP_SECURE

# SMS para recuperación por SMS (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Pagos con Conekta (sin llave privada los cargos se registran en modo SANDBOX)
CONEKTA_PRIVATE_KEY=

# Servicio biométrico (biometric-service/) y consulta de cédulas SEP
BIOMETRIC_SERVICE_URL=http://127.0.0.1:8000
# SEP_URL=https://www.cedulaprofesional.sep.gob.mx/cedula/buscaCedulaJson.action

# 1 = responde 503 en toda la API (mantenimiento)
MAINTENANCE=0
